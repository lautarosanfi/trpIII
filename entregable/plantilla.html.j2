<thead><tr><th>Regla de J2 tras «me planto»</th><th class="n">umbral</th><th class="n">P(J2 gana | J1 se plantó)</th><th class="n">P(J2 gana)</th><th class="n">simulado</th></tr></thead>
<tbody>
{% for f in R.e3.tabla %}
<tr{% if loop.last %} class="destacada"{% endif %}><td>{{ f.nombre }}</td><td class="n">{{ f.t|c(3) }}</td><td class="n">{{ f.p_j2_si_planto|c(4) }}</td><td class="n">{{ f.p_j2_total|c(4) }}</td><td class="n">{{ f.p_j2_total_mc|c(4) }}</td></tr>
