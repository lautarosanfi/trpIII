<tbody>
{% for f in R.e7.convergencia %}
<tr><td class="n">{{ f.n }}</td><td class="n">{{ f.valor|c(5) }}</td><td>[{{ f.descarte_j1[0]|c(3) }}; {{ f.descarte_j1[1]|c(3) }}]</td><td>[{{ f.descarte_j2_tras_p[0]|c(3) }}; {{ f.descarte_j2_tras_p[1]|c(3) }}]</td><td>{% if f.descarte_j2_tras_d is none %}nunca descarta{% else %}descarta{% endif %}</td><td class="n">{{ f.celdas_mixtas_j1 }}</td></tr>
