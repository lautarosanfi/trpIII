<script>
(function () {
  "use strict";
  try {
    renderMathInElement(document.body, {
      delimiters: [{ left: "\\[", right: "\\]", display: true }, { left: "\\(", right: "\\)", display: false }],
      throwOnError: false
    });
  } catch (e) { /* sin KaTeX, las fórmulas quedan como texto */ }
  document.querySelectorAll(".katex").forEach(function (k) {
    if (k.closest(".katex-display")) return;
    var sig = k.nextSibling;
    if (!sig || sig.nodeType !== 3) return;
    var m = sig.textContent.match(/^[.,;:)»]+/);
    if (!m) return;
    var junto = document.createElement("span");
    junto.style.whiteSpace = "nowrap";
    k.parentNode.insertBefore(junto, k);
    junto.appendChild(k);
    junto.appendChild(document.createTextNode(m[0]));
    sig.textContent = sig.textContent.slice(m[0].length);
  });

  var $ = function (id) { return document.getElementById(id); };
  if (!$("grafico-lab")) return;
  var fmt = function (x, d) { return x.toFixed(d).replace(".", ","); };
  var pos = function (x) { return x > 0 ? x : 0; };
  function probJ1(s, t, tau) {
    return (2 * s - 1) * (0.5 - tau + tau * tau) + (2 * t - 1) * (1 - s * s) + 2 * (1 - t) * (1 - t) - 2 * pos(s - t) * pos(s - t);
  }
  function g(s) { return 0.25 + s / 2 - Math.pow(s, 4) / 2; }

  var sl = { s: $("s"), t: $("t"), tau: $("tau") }, optimo = $("optimo"), svg = $("grafico-lab");
  function leer() { return { s: +sl.s.value, t: +sl.t.value, tau: +sl.tau.value }; }

  function dibujar(v) {
    var W = 640, H = 230, L = 46, R = 12, T = 10, B = 40, y0 = 0.25, y1 = 0.55;
    var X = function (s) { return L + (s - 0.5) / 0.5 * (W - L - R); };
    var Y = function (p) { return T + (y1 - Math.min(Math.max(p, y0), y1)) / (y1 - y0) * (H - T - B); };
    var h = '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + (H - B) + '" y2="' + (H - B) + '" class="rama"/>' +
            '<line x1="' + L + '" x2="' + L + '" y1="' + T + '" y2="' + (H - B) + '" class="rama"/>';
    [0.3, 0.4, 0.5].forEach(function (p) {
      h += '<line x1="' + (L - 4) + '" x2="' + L + '" y1="' + Y(p) + '" y2="' + Y(p) + '" class="rama"/>' +
           '<text x="' + (L - 8) + '" y="' + (Y(p) + 4) + '" text-anchor="end" class="chico">' + fmt(p, 1) + '</text>';
    });
    [0.5, 0.6, 0.7, 0.8, 0.9, 1].forEach(function (s) {
      h += '<line x1="' + X(s) + '" x2="' + X(s) + '" y1="' + (H - B) + '" y2="' + (H - B + 4) + '" class="rama"/>' +
           '<text x="' + X(s) + '" y="' + (H - B + 18) + '" text-anchor="middle" class="chico">' + fmt(s, 1) + '</text>';
    });
    h += '<text x="' + ((W + L) / 2) + '" y="' + (H - 3) + '" text-anchor="middle" class="chico it">umbral s de J1</text>';
    var p1 = "", p2 = "";
    for (var i = 0; i <= 200; i++) {
      var s = 0.5 + i / 400;
      p1 += (i ? "L" : "M") + X(s).toFixed(1) + "," + Y(g(s)).toFixed(1);
      p2 += (i ? "L" : "M") + X(s).toFixed(1) + "," + Y(probJ1(s, v.t, v.tau)).toFixed(1);
    }
    if (!optimo.checked) h += '<path d="' + p2 + '" fill="none" stroke="#9a958b" stroke-width="1.6"/>';
    h += '<path d="' + p1 + '" fill="none" stroke="#30569a" stroke-width="1.8"/>';
    var p = probJ1(v.s, v.t, v.tau);
    h += '<circle cx="' + X(v.s) + '" cy="' + Y(p) + '" r="4.5" fill="#1d1c19" stroke="#fdfcf7" stroke-width="1.6"/>';
    svg.innerHTML = h;
  }

  function actualizar() {
    if (optimo.checked) {
      var s = +sl.s.value;
      sl.t.value = ((1 + s * s) / 2).toFixed(3);
      sl.tau.value = "0.5";
    }
    sl.t.disabled = sl.tau.disabled = optimo.checked;
    var v = leer();
    $("os").textContent = fmt(v.s, 3);
    $("ot").textContent = fmt(v.t, 3);
    $("otau").textContent = fmt(v.tau, 3);
    var p = probJ1(v.s, v.t, v.tau);
    $("pj1").textContent = fmt(p, 4);
    $("pj2").textContent = fmt(1 - p, 4);
    $("psim").textContent = "";
    dibujar(v);
  }

  function simular() {
    var v = leer(), n = 200000, gana = 0, R = Math.random;
    for (var k = 0; k < n; k++) {
      var x = R(), m1 = x > 0.5 ? x : 1 - x, planto = m1 >= v.s, v1 = planto ? m1 : R();
      var z = R(), m2 = z > 0.5 ? z : 1 - z, u = planto ? v.t : v.tau, v2 = m2 >= u ? m2 : R();
      if (v1 > v2) gana++;
    }
    var p = gana / n, ee = Math.sqrt(p * (1 - p) / n);
    $("psim").textContent = "J1 ganó " + fmt(p, 4) + " ± " + fmt(1.96 * ee, 4) + " de las partidas.";
  }

  ["s", "t", "tau"].forEach(function (k) { sl[k].addEventListener("input", actualizar); });
  optimo.addEventListener("change", actualizar);
  document.querySelectorAll(".laboratorio button[data-s]").forEach(function (b) {
    b.addEventListener("click", function () { sl.s.value = b.getAttribute("data-s"); optimo.checked = true; actualizar(); });
  });
  $("promedio").addEventListener("click", function () {
    optimo.checked = false; var s = +sl.s.value; sl.t.value = ((1 + s) / 2).toFixed(3); sl.tau.value = "0.5"; actualizar();
  });
  $("simular").addEventListener("click", function () {
    $("psim").textContent = "simulando…"; setTimeout(simular, 20);
  });
  actualizar();
})();
</script>
